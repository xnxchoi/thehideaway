# .env.example
#
# Copy this file to .env for local development and fill in real values.
# `.env` is gitignored — your real values stay on disk, never reach GitHub.
#
# How this file is consumed:
#   - Next.js auto-loads .env at dev/build/start time (no extra setup).
#   - Payload reads PAYLOAD_SECRET, DATABASE_URI, etc. from process.env.
#   - The local postgres Docker container (pnpm dev:pgstart) reads POSTGRES_*.
#
# Layering:
#   .env                ← committed-shape, your real local values (gitignored)
#   .env.local          ← Next.js dev-only overrides, beats .env (gitignored)
#   .env.production     ← deployed to the VPS only (gitignored)
#
# Generation helpers:
#   openssl rand -hex 32   → 64-char hex secret (PAYLOAD_SECRET, BETTER_AUTH_SECRET)
#   openssl rand -hex 16   → 32-char hex secret (CRON_SECRET, PREVIEW_SECRET)

# ── Application secrets ────────────────────────────────────────────────────────
PAYLOAD_SECRET=CHANGE_ME_openssl_rand_hex_32
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
PREVIEW_SECRET=CHANGE_ME_openssl_rand_hex_16
CRON_SECRET=CHANGE_ME_openssl_rand_hex_16

# ── OAuth — Google ─────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Dev callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Admin OAuth (a separate Google Cloud project is recommended)
AUTH_ADMINS_GOOGLE_ID=your_admin_google_client_id.apps.googleusercontent.com
AUTH_ADMINS_GOOGLE_SECRET=GOCSPX-your_admin_google_client_secret

# ── OAuth — Naver ──────────────────────────────────────────────────────────────
# https://developers.naver.com/apps/#/register
# Dev callback: http://localhost:3000/api/auth/oauth2/callback/naver
AUTH_NAVER_ID=your_naver_client_id
AUTH_NAVER_SECRET=your_naver_client_secret

# ── OAuth — Kakao ──────────────────────────────────────────────────────────────
# https://developers.kakao.com/console/app
# Dev callback: http://localhost:3000/api/auth/oauth2/callback/kakao
AUTH_KAKAO_ID=your_kakao_rest_api_key
AUTH_KAKAO_SECRET=your_kakao_client_secret

# ── External API keys ──────────────────────────────────────────────────────────
# Exchange rate (Korea Eximbank, free): https://www.koreaexim.go.kr/ir/HPHKIRD020M01
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Korean public holiday API (data.go.kr, free): https://www.data.go.kr
HOLIDAY_API_KEY=your_holiday_api_key

# Unsplash (free tier: 50 req/hr): https://unsplash.com/developers
API_KEY_UNSPLASH=your_unsplash_access_key

# Mapbox (for the settings → profile → location autocomplete)
# https://account.mapbox.com/access-tokens
MAPBOX_API_KEY=pk.your_mapbox_public_token

# ── Local database ─────────────────────────────────────────────────────────────
# Compose builds DATABASE_URI from these in dev. Direct connection works too.
POSTGRES_USER=postgres
POSTGRES_DB=theestate
POSTGRES_PASSWORD=postgres
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/theestate

# ── Application URLs (local) ───────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# ── Email (Brevo SMTP) ─────────────────────────────────────────────────────────
# https://app.brevo.com/settings/keys/smtp
EMAIL_FROM=concierge@hideawayseoul.com
EMAIL_FROM_NAME=Concierge @ The Hideaway
BREVO_SMTP_USER=your_brevo_smtp_login@smtp-brevo.com
BREVO_SMTP_PASS=your_brevo_smtp_password

# ── File size limits ───────────────────────────────────────────────────────────
NEXT_PUBLIC_IMAGE_MAX_FILE_SIZE=3*1024*1024
NEXT_PUBLIC_VIDEO_MAX_FILE_SIZE=10*1024*1024

# ── Public API base URLs ───────────────────────────────────────────────────────
NEXT_PUBLIC_EXCHANGE_RATE_URL=https://www.koreaexim.go.kr/site/program/financial/exchangeJSON
NEXT_PUBLIC_HOLIDAY_API_URL=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService

# ── Timezone ───────────────────────────────────────────────────────────────────
TZ=Asia/Seoul

# ── Payload CMS ────────────────────────────────────────────────────────────────
# Must match the @payloadcms/richtext-lexical version in package.json.
# Run: node -e "console.log(require('./node_modules/@payloadcms/richtext-lexical/package.json').version)"
PAYLOAD_LEXICAL_VERSION=28.0.1
