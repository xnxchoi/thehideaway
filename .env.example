# Development Environment Variables
# This file contains default/example values and can be committed to git
# For actual secrets, use .env.local (development) or .env.production (production)

# Application Secrets (use placeholder values)
PAYLOAD_SECRET=example_payload_secret_change_in_production
PREVIEW_SECRET=example_preview_secret_change_in_production
BETTER_AUTH_SECRET=example_better_auth_secret_change_in_production
CRON_SECRET=example_cron_secret_change_in_production

# OAuth Credentials (use placeholder values)
AUTH_NAVER_ID=example_auth_naver_id_here
AUTH_NAVER_SECRET=example_auth_naver_secret_here
GOOGLE_CLIENT_ID=example_google_client_id_here
GOOGLE_CLIENT_SECRET=example_google_client_secret_here
AUTH_ADMINS_GOOGLE_ID=your_admin_google_id_here
AUTH_ADMINS_GOOGLE_SECRET=your_admin_google_secret_here

# API Keys (use placeholder values)
EXCHANGE_RATE_API_KEY=your_exchange_rate_key_here
HOLIDAY_API_KEY=your_holiday_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_key_here
MAPBOX_API_KEY=example_mapbox_api_key_here
# Database Configuration
DATABASE_URI=example_database_uri_here
POSTGRES_PASSWORD=example_postgres_password_here
POSTGRES_USER=example_postgres_user_here
POSTGRES_DB=example_postgres_db_here

# Application URLs (development defaults)
NEXT_PUBLIC_SERVER_URL=example_next_public_server_url_here
NEXT_PUBLIC_BETTER_AUTH_URL=example_next_public_better_auth_url_here
COOKIE_DOMAIN=example_cookie_domain_here

# File Upload Limits
NEXT_PUBLIC_IMAGE_MAX_FILE_SIZE=3*1024*1024
NEXT_PUBLIC_VIDEO_MAX_FILE_SIZE=10*1024*1024

# External APIs
NEXT_PUBLIC_EXCHANGE_RATE_URL=https://www.koreaexim.go.kr/site/program/financial/exchangeJSON
NEXT_PUBLIC_HOLIDAY_API_URL=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService

# Timezone
TZ=Asia/Seoul

# Email Configuration (Brevo SMTP)
EMAIL_FROM=example_email_from_here
EMAIL_FROM_NAME=example_email_from_name_here
BREVO_SMTP_USER=example_brevo_smtp_user_here
BREVO_SMTP_PASS=example_brevo_smtp_pass_here

# Payload Configuration
PAYLOAD_LEXICAL_VERSION="28.0.1"
