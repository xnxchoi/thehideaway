# Ignore log files
*.log
*.zip
*.psd

# ── Agent / tool-generated verification artifacts ─────────────────────────────
# Screenshots, page snapshots, and audit captures produced by Chrome/Playwright
# MCP tooling during UI verification. Never source — regenerated on demand.
**/.codex-screenshots
**/.playwright-mcp
**/output



# ── Environment files — never commit plaintext secrets ────────────────────────
#
# Tracked:
#   .env.example, .env.local.example   — dev placeholder docs
#   .env.production.template            — autogenerated from src/lib/env.ts
#                                         (`pnpm env:template:gen`)
#   .env.production.enc                 — sops+age encrypted prod values.
#                                         Edit with `pnpm env:edit`.
#
# Untracked (real-value files, on-disk only):
#   .env, .env.local, .env.development.local, .env.test.local,
#   .env.production, .env.production.local
.env
.env*
!.env.production.template
!.env.production.enc

# Ignore node_modules folder
node_modules/
reference
.junie
tests
# Ignore MacOS .DS_Store file
.hintrc
.filenignore
.DS_Store
# .attic/ is the local archival stash (`pnpm attic <path>`). Gitignored.
# Never rm dormant code — park it here. Excluded from Docker + tsconfig.
.attic
.vscode
.idea
.codex
.next
.claude
.pnpm-store
.turbo
.git-support/archive-worktree/
.git-support/media.local.json
/thehideaway.code-workspace
backup/

test*/

tsconfig.tsbuildinfo


