# .env.production.example
#
# Copy this to .env.production on the VPS and fill in real values.
# NEVER commit .env.production to git.
#
# How this file is consumed:
#   - The payload container reads it via env_file: .env.production
#   - docker compose reads it for variable interpolation (${VAR} in compose.prod.yaml)
#     when prod.sh passes --env-file .env.production
#   - The postgres container reads POSTGRES_* vars from it
#
# Generation helpers:
#   openssl rand -hex 32   → 64-char hex secret (use for PAYLOAD_SECRET, BETTER_AUTH_SECRET, etc.)
#   openssl rand -hex 16   → 32-char hex secret (use for CRON_SECRET, PREVIEW_SECRET)

# ── Application secrets ────────────────────────────────────────────────────────
# Must be long random strings. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME_openssl_rand_hex_32
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
PREVIEW_SECRET=CHANGE_ME_openssl_rand_hex_16
CRON_SECRET=CHANGE_ME_openssl_rand_hex_16

# ── OAuth — Google ─────────────────────────────────────────────────────────────
# Frontend app (hideawayseoul.com): https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://hideawayseoul.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Admin OAuth (separate Google Cloud project recommended)
AUTH_ADMINS_GOOGLE_ID=your_admin_google_client_id.apps.googleusercontent.com
AUTH_ADMINS_GOOGLE_SECRET=GOCSPX-your_admin_google_client_secret

# ── OAuth — Naver ──────────────────────────────────────────────────────────────
# Register at: https://developers.naver.com/apps/#/register
# Callback URL: https://hideawayseoul.com/api/auth/callback/naver
AUTH_NAVER_ID=your_naver_client_id
AUTH_NAVER_SECRET=your_naver_client_secret

# ── External API keys ──────────────────────────────────────────────────────────
# Exchange rate: https://www.koreaexim.go.kr/ir/HPHKIRD020M01 (free, register)
EXCHANGE_RATE_KEY=your_exchange_rate_api_key

# Korean public holiday API: https://www.data.go.kr (free, register)
HOLIDAY_API_KEY=your_holiday_api_key

# Unsplash: https://unsplash.com/developers (free tier: 50 req/hr)
API_KEY_UNSPLASH=your_unsplash_access_key

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URI is constructed by compose from the vars below and injected into
# the payload/migrate containers. These vars are also read by the postgres
# container and by prod.sh's backup_db function.
POSTGRES_USER=postgres
POSTGRES_DB=theestate
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password

# ── Application URLs ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=https://hideawayseoul.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://hideawayseoul.com
COOKIE_DOMAIN=hideawayseoul.com

# ── Email (Brevo SMTP) ─────────────────────────────────────────────────────────
# SMTP credentials from: https://app.brevo.com/settings/keys/smtp
EMAIL_FROM=concierge@hideawayseoul.com
EMAIL_FROM_NAME=Concierge @ The Hideaway
BREVO_SMTP_USER=your_brevo_smtp_login@smtp-brevo.com
BREVO_SMTP_PASS=your_brevo_smtp_password

# ── File size limits ───────────────────────────────────────────────────────────
NEXT_PUBLIC_IMAGE_MAX_FILE_SIZE=3*1024*1024
NEXT_PUBLIC_VIDEO_MAX_FILE_SIZE=10*1024*1024

# ── Public API base URLs ───────────────────────────────────────────────────────
NEXT_PUBLIC_EXCHANGE_RATE_URL=https://www.koreaexim.go.kr/site/program/financial/exchangeJSON
NEXT_PUBLIC_HOLIDAY_API_URL=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService

# ── Timezone ───────────────────────────────────────────────────────────────────
TZ=Asia/Seoul

# ── Payload CMS ────────────────────────────────────────────────────────────────
# Must match the @payloadcms/richtext-lexical version in package.json.
# Run: node -e "console.log(require('./node_modules/@payloadcms/richtext-lexical/package.json').version)"
PAYLOAD_LEXICAL_VERSION=28.0.1

# ── Manual checkout (bank transfer / cash) ─────────────────────────────────────
# Online card / KakaoPay / Toss are not wired yet. All subscriptions go through
# the manual flow: user clicks "request access" → pending Subscription created
# → admin marks paid:true in /vault to activate → role auto-promotes.
#
# Public bank account string shown on the /checkout page (safe to ship).
NEXT_PUBLIC_BANK_ACCOUNT=기업은행 · 000-000000-00-000 · The Hideaway
# Admin email that receives "new manual subscription pending" notifications.
ADMIN_EMAIL=concierge@hideawayseoul.com

# ── Static asset paths (Docker bind mounts) ────────────────────────────────────
# Host directory where the large 3D static assets live (~432 MB combined).
# compose.prod.yaml mounts these as read-only into the container.
#
# Bootstrap once before first deploy (run from local machine):
#   rsync -av --progress ./public/assets/plate/     <vps>:/opt/thehideaway/assets/plate/
#   rsync -av --progress ./public/assets/rp_plaque/ <vps>:/opt/thehideaway/assets/rp_plaque/
#   rsync -av --progress ./public/assets/three/     <vps>:/opt/thehideaway/assets/three/
ASSETS_HOST_PATH=/opt/thehideaway/assets
