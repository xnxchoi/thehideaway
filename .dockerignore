# Payload runtime upload directories — managed via Docker named volumes.
# These are written by Payload CMS at runtime (media uploads, user avatars,
# audio tracks). They must NOT be baked into the image:
#   1. Dev content would be shipped to production.
#   2. Files uploaded in production would vanish on container restart
#      unless mounted as a persistent volume.
# compose.prod.yaml mounts these as named volumes on the VPS.
public/media/
public/track_media/
public/users/
# assets/media is the Assets collection upload dir (small, same principle)
public/assets/media/

# ── Large 3D static assets (~432 MB combined) ────────────────────────────────
# These binary/texture files are committed to git for local dev but must NOT
# be baked into the production Docker image — they're served as plain static
# files and have no build-time role.
#
# compose.prod.yaml mounts them from the VPS filesystem at runtime.
#
# BOOTSTRAP (run once before first prod deploy):
#   rsync -av --progress ./public/assets/plate/     <vps>:/opt/thehideaway/assets/plate/
#   rsync -av --progress ./public/assets/rp_plaque/ <vps>:/opt/thehideaway/assets/rp_plaque/
#   rsync -av --progress ./public/assets/three/     <vps>:/opt/thehideaway/assets/three/
#
# After that, deploys are fast — the VPS host dirs persist across container
# restarts because bind mounts are never rebuilt like named volumes.
public/assets/plate/
public/assets/rp_plaque/
public/assets/three/
