{
  "name": "hideawayseoul",
  "version": "33.0.32",
  "description": "The Hideaway",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "docker desktop start && docker start postgres && wait-on tcp:5432 && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:init": "docker desktop start && docker start postgres && wait-on tcp:5432 && pnpm migrate && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "format": "next lint --fix && prettier '**/*.{json,yaml}' --write",
    "test": "vitest run",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts ./node_modules/.bin/payload generate:types",
    "generate:schema": "cross-env NODE_OPTIONS=--no-deprecation ./node_modules/.bin/payload generate:db-schema",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation ./node_modules/.bin/payload generate:importmap",
    "micreate": "PAYLOAD_CONFIG_PATH=src/payload.config.ts ./node_modules/.bin/payload migrate:create && node src/scripts/mig.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts ./node_modules/.bin/payload migrate",
    "migrate:fresh": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts ./node_modules/.bin/payload migrate:fresh",
    "attic": "bash scripts/attic.sh",
    "attic:init": "node scripts/attic-init.mjs",
    "attic:snap": "node scripts/attic-snap.mjs",
    "seed:rebuild": "tsx --env-file=.env --env-file=.env.local src/scripts/seedToMigration.ts",
    "verify:env": "node --no-warnings --experimental-strip-types scripts/verify-env.ts",
    "sync:deploy-rules": "node --no-warnings --experimental-strip-types scripts/sync-deploy-rules.ts sync",
    "verify:deploy-rules": "node --no-warnings --experimental-strip-types scripts/sync-deploy-rules.ts verify",
    "env:template:gen": "node --no-warnings --experimental-strip-types scripts/gen-env-template.ts gen",
    "env:template:verify": "node --no-warnings --experimental-strip-types scripts/gen-env-template.ts verify",
    "env:edit": "SOPS_AGE_KEY_FILE=\"$HOME/.config/sops/age/keys.txt\" sops --input-type dotenv --output-type dotenv .env.production.enc",
    "env:decrypt": "SOPS_AGE_KEY_FILE=\"$HOME/.config/sops/age/keys.txt\" sops --decrypt --input-type dotenv --output-type dotenv .env.production.enc",
    "env:rotate-keys": "SOPS_AGE_KEY_FILE=\"$HOME/.config/sops/age/keys.txt\" sops updatekeys .env.production.enc",
    "release:cut": "bash scripts/cut-release.sh",
    "release:check": "bash scripts/cut-release.sh --check",
    "oauth:approval:report": "node scripts/oauth-approval-report.mjs"
  },
