{
  "name": "hideawayseoul",
  "version": "33.0.0",
  "description": "The Hideaway",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "ci": "payload migrate && pnpm build",
    "dev": "pnpm run dev:pgstart && pnpm run db:wait && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:m": "pnpm run dev:pgstart && pnpm run db:wait && cross-env NODE_OPTIONS=--no-deprecation  pnpm run migrate &&next dev",
    "db:wait": "wait-on tcp:5432",
    "dev:init": "pnpm run dev:pgstart && pnpm run db:wait && pnpm run migrate && pnpm run dev",
    "dev:restart": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && next dev",
    "dev:docker": "sh ./devpostgres.sh",
    "dev:pgstart": "docker desktop start && docker start postgres",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && payload migrate && pnpm build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && node .next/standalone/server.js",
    "format": "next lint --fix && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "generate": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types&& payload generate:db-schema && rm src/app/\\(payload\\)/vault/importMap.js && payload generate:importmap",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:schema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "micreate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create && node src/scripts/mig.ts",
    "micreate:fresh": "cross-env NODE_OPTIONS=--no-deprecation rm -rf ./src/lib/migrations/* && payload migrate:create && node src/scripts/mig.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:fresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:fresh",
    "prod": "sh ./prod.sh",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "upgrade": "cross-env NODE_OPTIONS=--no-deprecation pnpm upgrade"
  },
