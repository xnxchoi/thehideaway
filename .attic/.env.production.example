# ── Database ───────────────────────────────────────────────────────────────────
# Do NOT set DATABASE_URI directly in prod — compose.prod.yaml constructs it
# from POSTGRES_* below and injects it into the payload/migrate containers as
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}.
# Setting it here would shadow the in-container hostname (which must be
# `postgres`, not `localhost` or `host.docker.internal`).
#
# These vars are read by:
#   - postgres container (for initdb)
#   - compose interpolation (to build DATABASE_URI for payload/migrate)
#   - prod.sh's backup_db function (for pg_dump credentials)
POSTGRES_USER=postgres
POSTGRES_DB=theestate
POSTGRES_PASSWORD=H1dden!

# ── Application URLs ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=https://hideawayseoul.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://hideawayseoul.com
