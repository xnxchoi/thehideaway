# .env.local.example
#
# Copy to .env.local for Next.js dev-only overrides. Values here beat .env
# but only when NODE_ENV !== 'production'. `.env.local` is gitignored.
#
# Typical use cases:
#   - Personal overrides you don't want to share with collaborators
#     (your own Brevo sandbox creds, a different DATABASE_URI to a local
#     PG instance, etc.)
#   - Dev-only switches that must never reach prod (DEV_BUTLER_PASSWORD)
#
# DO NOT put production secrets here. They will leak into commits the first
# time someone runs `git add -A` carelessly.

# ── Dev bypass user (Sign in as Butler) ────────────────────────────────────────
# When set in dev, seedButler.ts creates a "butler" admin with this password
# and the sign-in page shows a "Sign in as Butler" shortcut. The seed and
# the shortcut both refuse to run when NODE_ENV === 'production', so this
# var is safe to set here — but never set it in .env.production on the VPS.
#
# Minimum 8 chars (enforced by seedButler).
DEV_BUTLER_PASSWORD=pick_any_dev_password_min_8_chars

# ── Dev reader fixtures ────────────────────────────────────────────────────────
# Same idea for the reader fixture users (Daria, Miles) used to test
# multi-user interactions (follows, comments, citations). See
# src/lib/auth/dev/seedReaders.ts.
DEV_READER_PASSWORD=pick_any_dev_password_min_8_chars

# ── Spotify (optional — Radio dev) ─────────────────────────────────────────────
# Only needed if you're working on the Radio import/preview path. The prod
# stack doesn't use Spotify; tracks live in the local Tracks collection.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_SECRET=your_spotify_secret

# ── Unsplash (optional — admin image search dev) ──────────────────────────────
# Only needed if you're working on the image-search plugin and want to test
# against Unsplash specifically. Production uses API_KEY_UNSPLASH from .env.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_COLLECTION_ID=your_unsplash_collection_id

# ── Brevo (optional — email dev) ───────────────────────────────────────────────
# The MCP-based Brevo helper lives outside the runtime path; only set if you
# use it for local email testing.
BREVO_API=your_brevo_v3_api_key
BREVO_MCP_API=your_brevo_mcp_api_key

# ── Editor integration ─────────────────────────────────────────────────────────
# Lets Next.js error overlay open files in your editor when you click them.
# Common: "webstorm", "vscode", "code", "atom".
REACT_EDITOR=webstorm
