# .env.production.template — GENERATED FROM src/lib/env.ts. DO NOT EDIT BY HAND.
#
# This is the canonical "what does prod expect" document. Real values live
# encrypted in .env.production.enc (sops + age). To edit values, run:
#   pnpm env:edit
#
# To add/remove a variable: edit src/lib/env.ts, then run:
#   pnpm env:template:gen
#
# Tiers:
#   [required]   — prod boot fails without this
#   [optional]   — feature degrades gracefully if absent
#   [deployment] — read by docker-compose / postgres, not by the Next.js app
#   [dev]        — local-dev only; must NOT be set on the prod VPS

# ── Application secrets ────────────────────────────────────────────

# Server-side secret signing JWTs and CSRF tokens.
# [required]  hint: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32

# Better Auth signing secret.
# [required]  hint: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32

# SHA-256 digest of the temporary LOSTINSEOUL preview password.
# [required]  hint: printf %s 'strong-password' | shasum -a 256
LOSTINSEOUL_GATE_PASSWORD_SHA256=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32

# Preview-mode shared secret (URL token for draft posts).
# [required]  hint: openssl rand -hex 16
PREVIEW_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32

# Auth token for cron-triggered endpoints.
# [required]  hint: openssl rand -hex 16
CRON_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32

# ── Database (compose-interpolated POSTGRES_* build DATABASE_URI) ────────────────────────────────────────────

# Postgres connection string. In prod, compose constructs this from POSTGRES_*
# below.
# [required]  hint: postgresql://USER:PASSWORD@postgres:5432/DB
DATABASE_URI=postgresql://USER:PASSWORD@postgres:5432/DB

# Username for the postgres container and compose-built DATABASE_URI.
# [deployment]
POSTGRES_USER=postgres

# Password for the postgres container. Must contain no URI-reserved characters
# (@ : / ? # [ ]).
# [deployment]
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Database name. Must match the schema your migrations target.
# [deployment]  hint: theestate
POSTGRES_DB=theestate

# ── OAuth — end-user sign-in ────────────────────────────────────────────

# Google OAuth client ID for end-user sign-in.
# [required]  hint: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=CHANGE_ME_CLIENT_ID

# Google OAuth client secret.
# [required]  hint: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET

# Naver OAuth client ID.
# [required]  hint: https://developers.naver.com/apps/
AUTH_NAVER_ID=CHANGE_ME_CLIENT_ID

# Naver OAuth client secret.
# [required]  hint: https://developers.naver.com/apps/
AUTH_NAVER_SECRET=CHANGE_ME_CLIENT_SECRET

# Kakao OAuth REST API key for end-user sign-in.
# [required]  hint: https://developers.kakao.com/console/app
AUTH_KAKAO_ID=CHANGE_ME_CLIENT_ID

# Kakao OAuth client secret.
# [required]  hint: https://developers.kakao.com/console/app
AUTH_KAKAO_SECRET=CHANGE_ME_CLIENT_SECRET

# Cookie domain for cross-subdomain session sharing.
# [optional]  hint: hideawayseoul.com
COOKIE_DOMAIN=example.com

# ── Admin OAuth (separate Google project) ────────────────────────────────────────────

# Admin-only Google OAuth client ID (separate GCP project recommended).
# [optional]
AUTH_ADMINS_GOOGLE_ID=CHANGE_ME_CLIENT_ID

# Admin-only Google OAuth client secret.
# [optional]
AUTH_ADMINS_GOOGLE_SECRET=CHANGE_ME_CLIENT_SECRET

# ── Public URLs (baked into client bundle at build) ────────────────────────────────────────────

# Canonical site origin used for absolute URL construction.
# [required]  hint: https://hideawayseoul.com
NEXT_PUBLIC_SERVER_URL=https://example.com

# Better Auth base URL (typically same as NEXT_PUBLIC_SERVER_URL).
# [required]  hint: https://hideawayseoul.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://example.com

# Extra trusted origin for Better Auth (only set when staging/preview hosts
# share prod cookies).
# [optional]
NEXT_PUBLIC_PRODUCTION_URL=https://example.com

# LOSTINSEOUL storefront origin routed into the same Next/Payload app.
# [optional]  hint: https://lostinseoul.com
NEXT_PUBLIC_LOSTINSEOUL_URL=https://example.com

# Legacy Payload fallback for absolute URL composition in admin meta. Defaults
# to NEXT_PUBLIC_SERVER_URL.
# [optional]
PAYLOAD_PUBLIC_SERVER_URL=https://example.com

# Email-template absolute-URL fallback. Only set if the renderer can't reach
# NEXT_PUBLIC_SERVER_URL.
# [optional]
BASE_URL=https://example.com

# Client-side fallback used by the email-template preview UI.
# [optional]
NEXT_PUBLIC_BASE_URL=https://example.com

# ── External APIs (currency, holiday, maps) ────────────────────────────────────────────

# Korea Eximbank FX API auth key.
# [required]  hint: https://www.koreaexim.go.kr/
EXCHANGE_RATE_API_KEY=CHANGE_ME_API_KEY

# Korean public-holiday data.go.kr service key.
# [required]  hint: https://www.data.go.kr/
HOLIDAY_API_KEY=CHANGE_ME_API_KEY

# Eximbank FX endpoint URL. Baked into the client bundle.
# [required]
NEXT_PUBLIC_EXCHANGE_RATE_URL=https://example.com/api

# Holiday API base URL. Baked into the client bundle.
# [required]
NEXT_PUBLIC_HOLIDAY_API_URL=https://example.com/api

# Mapbox token for /api/places/search autocomplete.
# [optional]  hint: https://account.mapbox.com/access-tokens
MAPBOX_API_KEY=CHANGE_ME_API_KEY

# PortOne Global client key for LOSTINSEOUL checkout.
# [optional]  hint: https://admin.portone.cloud/
PORTONE_CLIENT_KEY=CHANGE_ME_API_KEY

# PortOne Global server secret for signing and webhook reconciliation.
# [optional]  hint: https://admin.portone.cloud/
PORTONE_SECRET_KEY=CHANGE_ME_API_KEY

# Bearer JWT for PortOne server APIs such as refunds.
# [optional]  hint: https://docs.portone.cloud/reference/post_api-refund-portone-order-ref
PORTONE_API_JWT=CHANGE_ME_API_KEY

# PortOne V2 Store ID for LOSTINSEOUL checkout.
# [optional]  hint: https://developers.portone.io/opi/ko/integration/start/v2/checkout?v=v2
PORTONE_STORE_ID=CHANGE_ME_API_KEY

# PortOne V2 channel key for LOSTINSEOUL checkout.
# [optional]  hint: https://developers.portone.io/opi/ko/integration/start/v2/checkout?v=v2
PORTONE_CHANNEL_KEY=CHANGE_ME_API_KEY

# PortOne V2 API Secret for server-side payment verification.
# [optional]  hint: https://developers.portone.io/opi/ko/quick-guide/payment?v=v2
PORTONE_API_SECRET=CHANGE_ME_API_KEY

# PortOne checkout environment. Defaults to sandbox when unset.
# [optional]
PORTONE_ENVIRONMENT=CHANGE_ME_API_KEY

# Default PortOne payment channel key for checkout payloads.
# [optional]
PORTONE_DEFAULT_CHANNEL=CHANGE_ME_API_KEY

# Default PortOne payment method for checkout payloads.
# [optional]
PORTONE_DEFAULT_METHOD=CHANGE_ME_API_KEY

# Shared secret accepted by the LOSTINSEOUL PortOne webhook endpoint. For
# Standard-Webhooks signature verification use the whsec_… secret from the
# PortOne console.
# [required when PortOne is enabled]
PORTONE_WEBHOOK_SECRET=

# When "true", the PortOne webhook rejects requests without Standard-Webhooks
# signature headers (disables the legacy shared-secret header fallback).
# [required when PortOne is enabled]
PORTONE_WEBHOOK_REQUIRE_SIGNATURE=true

# Sandbox-only unsigned legacy compatibility. Never enable in production.
# [optional]
PORTONE_WEBHOOK_ALLOW_LEGACY=false

# Master gate for card checkout. Card options stay hidden and card routes reject
# unless this is exactly "true", even when PortOne keys are present. Keep
# unset/false until a sandbox card payment has round-tripped successfully — see
# readmes/PORTONE_APPLICATION.md.
# [optional]
PORTONE_CARD_CHECKOUT_LIVE=CHANGE_ME_API_KEY

# Master gate for stocked checkout reservations. Enabled only when exactly
# "true".
# [optional]
LOST_INVENTORY_RESERVATIONS_LIVE=false

# Gate for manual reservation mutations. Enabled only when exactly "true".
# [optional]
LOST_INVENTORY_RESERVATION_OPERATOR_MUTATIONS_LIVE=false

# Positive reservation lifetime in minutes.
# [optional]
LOST_INVENTORY_RESERVATION_TTL_MINUTES=

# Explicit stock-location code used by checkout.
# [optional]
LOST_INVENTORY_RESERVATION_LOCATION_CODE=

# Nonnegative stock held outside available-to-promise.
# [optional]
LOST_INVENTORY_SAFETY_STOCK=0

# Reservation consumption point.
# [optional]
LOST_INVENTORY_RESERVATION_CONSUME_POINT=payment_confirmed

# Reservation expiry boundary rule.
# [optional]
LOST_INVENTORY_EXPIRY_BOUNDARY=at_or_after

# Authoritative payment timestamp source.
# [optional]
LOST_INVENTORY_PAYMENT_TIME_SOURCE=provider_paid_at

# Late-payment handling policy.
# [optional]
LOST_INVENTORY_LATE_PAYMENT_POLICY=manual_review

# Backorder policy for stocked checkout.
# [optional]
LOST_INVENTORY_BACKORDER_MODE=disabled

# ── Email (Brevo SMTP — optional at launch) ────────────────────────────────────────────

# Brevo SMTP username (transactional email).
# [optional]  hint: https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_USER=CHANGE_ME

# Brevo SMTP password / API key.
# [optional]
BREVO_SMTP_PASS=CHANGE_ME

# Default From: address on outgoing transactional mail.
# [optional]
EMAIL_FROM=you@example.com

# Default sender display name.
# [optional]
EMAIL_FROM_NAME=Your Site

# Admin notification recipient (signup alerts, errors).
# [optional]
ADMIN_EMAIL=you@example.com

# ── Plugins (image search, audio metadata) ────────────────────────────────────────────

# Unsplash access key, mandatory since the site technically relies on unsplash
# to maintain a image-richlayout
# [optional]  hint: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=CHANGE_ME_PROVIDER_KEY

# Default Unsplash collection ID used by image-search.
# [optional]
UNSPLASH_COLLECTION_ID=CHANGE_ME_PROVIDER_KEY

# Spotify API client ID for the Radio collection metadata enrichment.
# [optional]
SPOTIFY_CLIENT_ID=CHANGE_ME_PROVIDER_KEY

# Spotify API client secret.
# [optional]
SPOTIFY_SECRET=CHANGE_ME_PROVIDER_KEY

# ── Site branding, limits, manual checkout ────────────────────────────────────────────

# Server-side site name used in email templates. Defaults to project literal.
# [optional]
SITE_NAME=CHANGE_ME

# Client-side site name (mirrors SITE_NAME for the email preview UI).
# [optional]
NEXT_PUBLIC_SITE_NAME=CHANGE_ME

# Per-upload byte cap, parsed as Number(). Example: 10485760 = 10 MB.
# [optional]
NEXT_PUBLIC_IMAGE_MAX_FILE_SIZE=CHANGE_ME

# Bank-transfer detail string shown on the manual-checkout success screen.
# [optional]
NEXT_PUBLIC_BANK_ACCOUNT=CHANGE_ME

# ── Dev-only — must NOT be set on prod VPS ────────────────────────────────────────────

# Dev-only password for the butler-login backdoor on /sign-in. Must be unset in
# prod.
# [dev]
DEV_BUTLER_PASSWORD=

# Dev-only password for the readers-seed fixture login.
# [dev]
DEV_READER_PASSWORD=

# ── Node runtime (compose sets these automatically) ────────────────────────────────────────────

# Node environment. Compose sets this to `production` in prod.
# [optional]
NODE_ENV=production
