{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/types/*": ["./src/types/*"],
      "@payload-types": ["./src/payload-types.ts"],
      "@payload-config": ["./src/payload.config.ts"],
      "@payload-auth/*": ["./src/lib/auth/payload-auth/*"],
      "@betterauth-ui": ["./src/lib/auth/betterauth-ui/src"],
      "@betterauth-ui/*": ["./src/lib/auth/betterauth-ui/src/*"],
      "@/AccessControlled/*": ["./src/payload/fields/AccessControlled/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "public/scripts/brightness.worker.js"
  ],
  "exclude": ["node_modules"]
}
