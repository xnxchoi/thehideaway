#!/bin/sh
set -eu

for required_path in \
  .git-support/README.md \
  .git-support/archive.json \
  .git-support/archive.mjs \
  .git-support/archive.test.ts \
  .git-support/hooks/pre-commit \
  .git-support/media.json \
  .git-support/media.mjs \
  .git-support/media.test.ts; do
  if ! git cat-file -e ":${required_path}" 2>/dev/null; then
    echo "Git support migration is not fully staged; missing ${required_path}." >&2
    exit 1
  fi
done

if git cat-file -e :media/catalog.json 2>/dev/null; then
  echo "The obsolete media/catalog.json path is still staged; stage its removal before committing." >&2
  exit 1
fi

node .git-support/media.mjs sync-staged --stage
