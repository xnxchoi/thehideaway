# .deployignore - GENERATED FROM deploy-manifest.json. DO NOT EDIT BY HAND.
# Edit deploy-manifest.json, then run `pnpm sync:deploy-rules`.
# CI runs `pnpm verify:deploy-rules` to catch drift.

# ── Version control ────────────────────────────────────────
.git
#   CI workflows belong on GitHub, not on the VPS
.github

# ── IDE / editor / OS ────────────────────────────────────────
.claude
.idea
.vscode
.DS_Store

# ── Build artifacts ────────────────────────────────────────
#   Docker builder stage installs fresh; rsync never benefits from shipping
#   these.
node_modules
#   Must NOT be in .dockerignore - pack.Dockerfile explicitly COPYs
#   .next/standalone and .next/static.
.next
.turbo
dist
coverage

# ── Code archaeology ────────────────────────────────────────
.attic
.grave
patches
#   Was previously rsync-only - extending to docker keeps the image consistent
#   with the dev exclusion intent.
reference
deploy-manifest.json
.deployignore
tsconfig.tsbuildinfo
next-env.d.ts
.env.production.enc
package.json
pnpm-lock.yaml
components.json
migrate.Dockerfile
pack.Dockerfile
compose.prod.yaml
.env.production.template
.gitignore
.sops.yaml
compose.dev.yaml
.dockerignore
.env.production
.env.local
pnpm-workspace.yaml
next.config.ts
AGENTS.md
CLAUDE.md
vitest.config.ts
index.d.ts
.env
tsconfig.json
.prettierrc
devpostgres.sh
dev.Dockerfile
tailwind.config.js
thehideaway.code-workspace
redirects.ts
postcss.config.mjs
eslint.config.mjs
fonts.ts

# ── Secrets ────────────────────────────────────────
.env
#   .env.production gets scp'd directly to /home/deploy/thehideaway/ with chmod
#   600 - never via rsync.
.env.*

# ── Runtime-managed upload directories (named volumes) ────────────────────────────────────────
#   compose.prod.yaml mounts payload_media at /app/public/media.
public/media/
#   Named volume payload_track_media.
public/track_media/
#   Named volume payload_users.
public/users/

# ── Large 3D static assets (bind-mounted at runtime) ────────────────────────────────────────
#   Rsync excludes the whole assets/ tree on first-deploy bootstrap; the VPS
#   gets these via a separate rsync to /opt/thehideaway/assets/. Smaller items
#   under public/assets/ (SVGs, fonts) are restored later by the deploy user's
#   git clone, which overlays the rsync'd repo dir.
public/assets

# ── eee ────────────────────────────────────────
src
e2e
messages
nginx
postgres
readmes
public

# ── Logs ────────────────────────────────────────
*.log
